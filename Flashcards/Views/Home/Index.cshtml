@model List<FlashcardsApp.Models.Flashcard>
@{
    ViewData["Title"] = "Flashcards";
}

<h1>Flashcards</h1>

<form method="post">
    @foreach (var flashcard in Model)
    {
        <div class="flashcard">
            <p><strong>Question:</strong> @flashcard.Question</p>
            <p><strong>Answer:</strong> @flashcard.Answer</p>
        </div>
    }
</form>
